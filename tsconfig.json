{
  // Type-checking only — `noEmit` is the whole point. The app still ships the
  // .js files the browser and Electron already load, there is no build step and
  // no bundler, and nothing here changes how the window is served. Types are
  // written as JSDoc in the .js sources, against the declarations in `types/`.
  //
  // Run it with `./oglimmer.sh test` (or `npx tsc --noEmit`).
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    // `preserve` is what lets one project hold both worlds: preload.js is
    // CommonJS (a sandboxed preload can't be ESM), main/ and renderer/ are ES
    // modules — main.mjs by extension, renderer by <script type="module">.
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "resolveJsonModule": true,

    // Not `strict` wholesale, but strictNullChecks is not optional: without it
    // TypeScript does not narrow `if (!res.ok) …`, and narrowing the `{ ok }`
    // envelope is the whole point of typing the bridge — a failure result must
    // not be readable as a successful one. `noImplicitAny` stays off so the
    // existing un-annotated code is checked where it can be rather than
    // reported line by line; turn it on one file at a time.
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["main.mjs", "main/**/*.mjs", "preload.js", "renderer/**/*.js", "scripts/**/*.js", "types/**/*.d.ts"],

  // scripts/smoke.js is the one source that is not checked, because it `require`s
  // playwright — which is deliberately not a dependency of this package (its
  // postinstall downloads browser engines nothing else here needs) and is
  // installed only into the linux mirror. `./oglimmer.sh test` still parses it.
  "exclude": ["node_modules", "dist", "scripts/smoke.js"]
}
