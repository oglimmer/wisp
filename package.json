{
  "name": "wisp",
  "version": "0.1.12",
  "description": "A minimal folder-backed Markdown note editor. Shows a folder tree on the left and a raw-text editor on the right.",
  "main": "main.mjs",
  "desktopName": "com.oglimmer.wisp.desktop",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz deb --x64",
    "dist:linux:flatpak": "npm run build && electron-builder --linux flatpak --x64",
    "postinstall": "node scripts/pty-permissions.js"
  },
  "author": {
    "name": "Oli Zimpasser",
    "email": "oglimmer@gmail.com"
  },
  "homepage": "https://oglimmer.github.io/wisp-homepage",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "acorn": "^8.18.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "node-pty": "^1.1.0",
    "turndown": "^7.2.4"
  },
  "build": {
    "appId": "com.oglimmer.wisp",
    "productName": "Wisp",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "main/**",
      "preload.js",
      "renderer/**",
      "index.html",
      "styles.css",
      "!**/*.ts",
      "!**/*.mts",
      "!**/*.map",
      "!node_modules/node-pty/prebuilds/win32-*",
      "!node_modules/node-pty/prebuilds/darwin-x64"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "flatpak",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Office",
      "synopsis": "A minimal folder-backed Markdown note editor",
      "maintainer": "Oli Zimpasser <oglimmer@gmail.com>",
      "syncDesktopName": true
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "branch": "stable",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--filesystem=host",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.freedesktop.Flatpak"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "publish": null
  }
}
