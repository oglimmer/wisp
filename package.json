{
  "name": "wisp",
  "version": "0.1.8",
  "description": "A minimal folder-backed Markdown note editor. Shows a folder tree on the left and a raw-text editor on the right.",
  "main": "main.js",
  "desktopName": "wisp.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "dist:linux": "electron-builder --linux --x64",
    "postinstall": "node scripts/pty-permissions.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "acorn": "^8.18.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "node-pty": "^1.1.0",
    "turndown": "^7.2.4"
  },
  "build": {
    "appId": "com.oglimmer.wisp",
    "productName": "Wisp",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "index.html",
      "styles.css",
      "!node_modules/node-pty/prebuilds/win32-*",
      "!node_modules/node-pty/prebuilds/darwin-x64"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Office",
      "synopsis": "A minimal folder-backed Markdown note editor",
      "syncDesktopName": true
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "publish": null
  }
}
